{
  "name": "burrito-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint -c eslint.config.mjs ./src/**/*.{ts,tsx} --report-unused-disable-directives --max-warnings 0 .",
    "preview": "vite preview",
    "format": "prettier --config .prettierrc 'src/**/*.{ts,tsx}' --write",
    "format-check": "prettier --config .prettierrc 'src/**/*.{ts,tsx}' --check"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.0.0",
    "axios": "^1.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-focus-lock": "^2.13.7",
    "react-router": "^8.3.0",
    "react-tooltip": "^6.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
